---
// src/pages/admin/races.astro
// Admin race tools: coverage overview + district simulator.
// Requires admin role — enforced by /api/admin/races/* routes.
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Race Admin | Grassroots Movement">
  <main class="max-w-5xl mx-auto px-4 py-10">
    <div class="mb-6 flex items-center gap-4">
      <a href="/admin/" class="text-wy-rust text-sm hover:underline">&larr; Admin tools</a>
    </div>

    <h1 class="font-serif text-3xl font-bold text-wy-charcoal mb-2">Race admin tools</h1>
    <p class="text-wy-charcoal/70 mb-10">Race coverage overview and district race simulator. Data is live from local D1.</p>

    {/* ── District simulator ── */}
    <section class="mb-12">
      <h2 class="font-serif text-xl font-bold text-wy-charcoal mb-1">District simulator</h2>
      <p class="text-sm text-wy-charcoal/70 mb-5">
        Preview which races a verified voter in any district would see on /races/my.
        Uses <code class="bg-wy-bone px-1 rounded">/api/admin/races/preview</code> — same filtering logic as the live endpoint.
      </p>
      <div class="flex flex-wrap gap-3 items-end mb-5">
        <label class="block">
          <span class="block text-xs font-bold uppercase tracking-wide text-wy-charcoal mb-1">House District</span>
          <input id="sim-house" type="number" min="1" max="62" placeholder="e.g. 5"
            class="w-28 rounded-md border border-wy-dust bg-white px-3 py-2 text-wy-charcoal" />
        </label>
        <label class="block">
          <span class="block text-xs font-bold uppercase tracking-wide text-wy-charcoal mb-1">Senate District</span>
          <input id="sim-senate" type="number" min="1" max="31" placeholder="e.g. 3"
            class="w-28 rounded-md border border-wy-dust bg-white px-3 py-2 text-wy-charcoal" />
        </label>
        <button id="sim-run" class="button button--primary" type="button">Preview races</button>
      </div>
      <div id="sim-result" class="hidden">
        <p id="sim-meta" class="text-sm text-wy-charcoal/70 mb-4"></p>
        <div id="sim-grid" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"></div>
      </div>
      <p id="sim-error" class="hidden text-red-700 text-sm"></p>
    </section>

    {/* ── Dev bypass reminder ── */}
    <section class="mb-12 rounded-lg border border-wy-dust bg-wy-bone p-5">
      <h2 class="font-serif text-lg font-bold text-wy-charcoal mb-2">Dev bypass (local only)</h2>
      <p class="text-sm text-wy-charcoal/70 mb-3">
        On localhost, <code class="bg-white px-1 rounded">/api/races/my</code> accepts
        <code class="bg-white px-1 rounded">?_dev_house=05&amp;_dev_senate=03</code> to skip auth.
        The <code class="bg-white px-1 rounded">/races/my</code> page accepts the same params and passes them through.
        Never active in production — guarded by <code class="bg-white px-1 rounded">isLocalEnv(env)</code>.
      </p>
      <div class="flex flex-wrap gap-3 items-end">
        <label class="block">
          <span class="block text-xs font-bold uppercase tracking-wide text-wy-charcoal mb-1">House</span>
          <input id="dev-house" type="number" min="1" max="62" placeholder="e.g. 5"
            class="w-28 rounded-md border border-wy-dust bg-white px-3 py-2 text-wy-charcoal" />
        </label>
        <label class="block">
          <span class="block text-xs font-bold uppercase tracking-wide text-wy-charcoal mb-1">Senate</span>
          <input id="dev-senate" type="number" min="1" max="31" placeholder="e.g. 3"
            class="w-28 rounded-md border border-wy-dust bg-white px-3 py-2 text-wy-charcoal" />
        </label>
        <a id="dev-link" href="/races/my" class="button button--secondary" target="_blank">Open /races/my with bypass</a>
      </div>
      <p class="text-xs text-wy-charcoal/50 mt-3">This link only works when running locally (wrangler dev). It has no effect in production.</p>
    </section>

    {/* ── Coverage overview ── */}
    <section>
      <div class="flex items-center gap-4 mb-5">
        <h2 class="font-serif text-xl font-bold text-wy-charcoal">Race coverage overview</h2>
        <button id="coverage-load" class="button button--secondary text-sm" type="button">Load</button>
      </div>
      <p id="coverage-meta" class="text-sm text-wy-charcoal/70 mb-4 hidden"></p>
      <div class="overflow-x-auto">
        <table id="coverage-table" class="hidden w-full text-sm border-collapse">
          <thead>
            <tr class="bg-wy-charcoal text-white text-left">
              <th class="px-3 py-2 font-semibold">Race</th>
              <th class="px-3 py-2 font-semibold">Category</th>
              <th class="px-3 py-2 font-semibold">District</th>
              <th class="px-3 py-2 font-semibold text-center">Candidates</th>
              <th class="px-3 py-2 font-semibold text-center">Poll seeded</th>
              <th class="px-3 py-2 font-semibold">Last reviewed</th>
            </tr>
          </thead>
          <tbody id="coverage-body"></tbody>
        </table>
      </div>
      <p id="coverage-error" class="hidden text-red-700 text-sm"></p>
    </section>
  </main>
</BaseLayout>

<script>
(function () {
  /* ── District simulator ── */
  const simHouse = document.getElementById('sim-house') as HTMLInputElement;
  const simSenate = document.getElementById('sim-senate') as HTMLInputElement;
  const simRun = document.getElementById('sim-run');
  const simResult = document.getElementById('sim-result');
  const simMeta = document.getElementById('sim-meta');
  const simGrid = document.getElementById('sim-grid');
  const simError = document.getElementById('sim-error');

  simRun && simRun.addEventListener('click', async function () {
    if (simError) { simError.textContent = ''; simError.classList.add('hidden'); }
    if (simResult) simResult.classList.add('hidden');
    const house = simHouse?.value || '';
    const senate = simSenate?.value || '';
    if (!house && !senate) { if (simError) { simError.textContent = 'Enter at least one district.'; simError.classList.remove('hidden'); } return; }
    const params = new URLSearchParams();
    if (house) params.set('house', house);
    if (senate) params.set('senate', senate);
    try {
      const res = await fetch('/api/admin/races/preview?' + params.toString(), { credentials: 'include' });
      if (!res.ok) { const d = await res.json(); throw new Error(d.error || res.statusText); }
      const data = await res.json();
      if (simMeta) simMeta.textContent = `HD-${data.house_district || '—'} / SD-${data.senate_district || '—'} → ${data.race_count} races`;
      if (simGrid) {
        simGrid.innerHTML = (data.races || []).map((r: any) => {
          const poll = r.survey_slug
            ? `<span class="text-green-700 font-semibold">✓ ${escH(r.survey_slug)}</span>`
            : `<span class="text-amber-600">No poll</span>`;
          return `<div class="rounded border border-wy-dust bg-wy-bone/40 p-3">
            <p class="text-xs font-bold uppercase tracking-wide text-wy-rust mb-1">${escH(r.race_category)}</p>
            <p class="font-semibold text-wy-charcoal text-sm mb-1">${escH(r.race_title)}</p>
            <p class="text-xs text-wy-charcoal/60">${r.candidate_count} candidates &bull; ${poll}</p>
          </div>`;
        }).join('');
      }
      if (simResult) simResult.classList.remove('hidden');
    } catch (e: any) {
      if (simError) { simError.textContent = e.message || 'Error'; simError.classList.remove('hidden'); }
    }
  });

  /* ── Dev bypass link builder ── */
  const devHouse = document.getElementById('dev-house') as HTMLInputElement;
  const devSenate = document.getElementById('dev-senate') as HTMLInputElement;
  const devLink = document.getElementById('dev-link') as HTMLAnchorElement;

  function updateDevLink() {
    const params = new URLSearchParams();
    if (devHouse?.value) params.set('_dev_house', devHouse.value);
    if (devSenate?.value) params.set('_dev_senate', devSenate.value);
    const qs = params.toString();
    if (devLink) devLink.href = qs ? `/races/my?${qs}` : '/races/my';
  }
  devHouse && devHouse.addEventListener('input', updateDevLink);
  devSenate && devSenate.addEventListener('input', updateDevLink);

  /* ── Coverage table ── */
  const coverageLoad = document.getElementById('coverage-load');
  const coverageMeta = document.getElementById('coverage-meta');
  const coverageTable = document.getElementById('coverage-table');
  const coverageBody = document.getElementById('coverage-body');
  const coverageError = document.getElementById('coverage-error');

  coverageLoad && coverageLoad.addEventListener('click', async function () {
    if (coverageError) { coverageError.textContent = ''; coverageError.classList.add('hidden'); }
    try {
      const res = await fetch('/api/admin/races/overview', { credentials: 'include' });
      if (!res.ok) { const d = await res.json(); throw new Error(d.error || res.statusText); }
      const data = await res.json();
      const races = data.races || [];
      const seeded = races.filter((r: any) => r.survey_slug).length;
      if (coverageMeta) {
        coverageMeta.textContent = `${races.length} races total — ${seeded} with poll seeded, ${races.length - seeded} without`;
        coverageMeta.classList.remove('hidden');
      }
      if (coverageBody) {
        coverageBody.innerHTML = races.map((r: any) => {
          const distLabel = r.district_number ? `${r.district_type === 'state_house' ? 'HD' : 'SD'}-${r.district_number}` : '—';
          const pollCell = r.survey_slug
            ? `<td class="px-3 py-2 text-center text-green-700">✓</td>`
            : `<td class="px-3 py-2 text-center text-amber-600">✗</td>`;
          return `<tr class="border-t border-wy-dust/50 hover:bg-wy-bone/30">
            <td class="px-3 py-2 text-wy-charcoal">${escH(r.race_title)}</td>
            <td class="px-3 py-2 text-wy-charcoal/70">${escH(r.race_category)}</td>
            <td class="px-3 py-2 text-wy-charcoal/70">${escH(distLabel)}</td>
            <td class="px-3 py-2 text-center text-wy-charcoal">${r.candidate_count}</td>
            ${pollCell}
            <td class="px-3 py-2 text-wy-charcoal/60 text-xs">${r.last_reviewed_at || '—'}</td>
          </tr>`;
        }).join('');
      }
      if (coverageTable) coverageTable.classList.remove('hidden');
      if (coverageLoad) (coverageLoad as HTMLButtonElement).textContent = 'Reload';
    } catch (e: any) {
      if (coverageError) { coverageError.textContent = e.message || 'Error'; coverageError.classList.remove('hidden'); }
    }
  });

  function escH(s: any) {
    return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }
})();
</script>
