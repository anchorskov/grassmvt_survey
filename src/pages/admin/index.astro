---
// src/pages/admin/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Admin | Grassroots Movement">
  <main class="max-w-2xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold text-wy-charcoal mb-2">Admin tools</h1>
    <p class="helper-text mb-6">Issue verified voter links for specific accounts.</p>

    <div class="survey-form">
      <div class="section-heading-inline">
        <h2>Verified voter link</h2>
        <button class="section-help-trigger" type="button" aria-label="Help for verified voter link section" aria-expanded="false" data-help-page="admin-tools" data-help-section="verified-voter-link">?</button>
      </div>
      <form id="admin-verify-voter-form">
        <div class="form-row">
          <label for="admin-verify-email">Target email</label>
          <input id="admin-verify-email" name="admin-verify-email" type="email" required />
        </div>
        <div class="form-row">
          <label for="admin-verify-notes">Notes (optional)</label>
          <input id="admin-verify-notes" name="admin-verify-notes" type="text" maxlength="200" />
        </div>
        <div class="form-row">
          <label for="admin-verify-expires">Expires in minutes (optional)</label>
          <input id="admin-verify-expires" name="admin-verify-expires" type="number" min="1" placeholder="30" />
        </div>
        <button class="button button--primary" type="submit">Issue link</button>
        <p class="form-error is-hidden" id="admin-verify-error" role="alert"></p>
        <p class="survey-success is-hidden" id="admin-verify-success" role="status"></p>
        <p class="helper-text is-hidden" id="admin-verify-link"></p>
      </form>
    </div>

    <div class="survey-form" style="margin-top:1.5rem">
      <div class="section-heading-inline">
        <h2>Users list</h2>
        <button class="section-help-trigger" type="button" aria-label="Help for users list section" aria-expanded="false" data-help-page="admin-tools" data-help-section="users-list">?</button>
      </div>
      <div class="form-row">
        <label for="admin-users-filter">Filter</label>
        <select id="admin-users-filter" name="admin-users-filter">
          <option value="verified" selected>Verified</option>
          <option value="unverified">Unverified</option>
          <option value="all">All</option>
        </select>
      </div>
      <button class="button button--secondary" type="button" id="admin-users-refresh">Load users</button>
      <p class="form-error is-hidden" id="admin-users-error" role="alert"></p>
      <p class="helper-text is-hidden" id="admin-users-meta"></p>
      <div id="admin-users-results" style="margin-top:1rem"></div>
    </div>
  </main>

  <Fragment slot="scripts">
    <script is:inline src="/js/admin-verify-voter.js"></script>
  </Fragment>
</BaseLayout>
