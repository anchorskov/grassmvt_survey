---
// src/pages/ballot/quiz/index.astro
// Voter issue quiz — auth + data loading handled client-side by ballot-quiz.js
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Your Issue Quiz — My Wyoming Ballot Guide"
  description="Answer a short issue quiz and set what matters most to you. We'll show how closely each candidate on your ballot matches your priorities."
>
  <header class="ballot-page-header">
    <div class="ballot-page-header__inner">
      <p class="ballot-page-header__eyebrow">My Wyoming Ballot Guide</p>
      <h1 class="ballot-page-header__title">What matters most to you?</h1>
      <p class="ballot-page-header__sub">
        Answer each question and tell us how much it matters. We'll use your answers to show
        how closely each candidate on your ballot lines up with what you care about — never a
        recommendation, always a breakdown you can inspect.
      </p>
    </div>
  </header>

  <p
    id="quiz-status"
    class="text-sm italic text-wy-charcoal/60"
    aria-live="polite"
    style="max-width: 820px; margin: 1rem auto 0; padding: 0 1.25rem;"
  >
    Loading your quiz…
  </p>
  <div id="quiz-root"></div>
</BaseLayout>

<script is:inline src="/js/ballot-quiz.js"></script>
