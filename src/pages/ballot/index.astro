---
// src/pages/ballot/index.astro
// Ballot card page — auth + data loading handled client-side by ballot.js
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Your Wyoming Ballot — 2026 | Grassroots Movement"
  description="Review candidates in your Wyoming districts, choose who you support, and record your notes for the 2026 election."
>
  {/* ── Page hero ── */}
  <section class="bg-wy-charcoal text-white" aria-labelledby="ballot-page-title">
    <div class="mx-auto max-w-5xl px-6 py-12 md:py-16">
      <p class="mb-2 text-xs font-bold uppercase tracking-widest text-wy-sandstone">2026 General Election</p>
      <h1 id="ballot-page-title" class="mb-3 font-serif text-4xl font-bold leading-tight md:text-5xl">
        Your Wyoming Ballot
      </h1>
      <p class="max-w-2xl text-lg leading-relaxed text-white/80">
        Races in your House and Senate districts, plus statewide and federal offices.
        Choose candidates and add your notes for each race.
      </p>
    </div>
  </section>

  {/* ── Status + content root ── */}
  <div class="bg-wy-bone min-h-screen">
    <div class="mx-auto max-w-3xl px-5 py-8">
      <p
        id="ballot-status"
        class="text-sm italic text-wy-charcoal/60"
        aria-live="polite"
      >
        Loading your ballot…
      </p>
      <div id="ballot-root"></div>
    </div>
  </div>
</BaseLayout>

<script is:inline src="/js/doc-viewer.js"></script>
<script is:inline src="/js/ballot.js"></script>
