---
// src/pages/bias/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Bias Review | Grassroots Movement">
  <main>
    <h1>Bias review</h1>
    <p>
      We invite participants to flag survey wording or results that feel biased. Reports are
      reviewed by the team and documented in our transparency notes.
    </p>
    <p>
      If you spot something concerning, please contact us with the survey name and the specific
      item you want reviewed.
    </p>
  </main>
</BaseLayout>
