---
// src/pages/surveys/list/index.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout title="Browse Surveys | Grassroots Movement">
  <main
    class="survey-browse-page"
    data-survey-browser-page
    data-survey-path="all"
    data-page-title="Browse surveys"
  >
    <section class="survey-browse-page__hero" aria-labelledby="survey-browse-title">
      <p class="survey-browse-page__eyebrow">Survey paths</p>
      <h1 id="survey-browse-title">Browse surveys</h1>
      <p class="survey-browse-page__lede">
        Choose a path, review current topics, and see which surveys are active now versus still in the queue.
      </p>
    </section>

    <section class="survey-path-picker" aria-labelledby="survey-path-picker-title">
      <div class="survey-path-picker__header">
        <h2 id="survey-path-picker-title">
          Choose a survey path
          <button class="section-help-trigger" type="button" aria-label="Help: survey paths" aria-expanded="false" data-help-page="survey-list" data-help-section="survey-paths">?</button>
        </h2>
        <p class="helper-text" id="survey-auth-note">
          Browse topics now. <button class="link-button" type="button" data-auth-open="login">Sign in</button> when
          you are ready to save progress or edit responses.
        </p>
      </div>
      <div class="survey-path-picker__grid">
        <a class="survey-path-picker__card" href="/surveys/normal-life/" data-survey-path-link="normal-life">
          <span class="survey-path-picker__label">Normal Life Surveys</span>
          <strong>Short, fast, everyday issues.</strong>
          <span>Cost of living, care access, work, local systems, and other day-to-day concerns.</span>
        </a>
        <a class="survey-path-picker__card" href="/surveys/divisive/" data-survey-path-link="divisive">
          <span class="survey-path-picker__label">Divisive Surveys</span>
          <strong>Deeper topics and tradeoffs.</strong>
          <span>Issues that need more context, sharper tradeoffs, and more deliberate public signal.</span>
        </a>
      </div>
    </section>

    <section class="survey-listings__section" id="survey-active-section" aria-labelledby="survey-active-title">
      <div class="survey-listings__header">
        <h2 id="survey-active-title">
          Active surveys
          <button class="section-help-trigger" type="button" aria-label="Help: active surveys" aria-expanded="false" data-help-page="survey-list" data-help-section="active-surveys">?</button>
        </h2>
        <p class="helper-text" id="survey-active-intro"></p>
      </div>
      <div id="survey-active-grid" class="grid"></div>
    </section>

    <section class="survey-listings__section is-hidden" id="survey-bridge-section" aria-labelledby="survey-bridge-title">
      <div class="survey-listings__header">
        <h2 id="survey-bridge-title">
          Bridge surveys
          <button class="section-help-trigger" type="button" aria-label="Help: bridge surveys" aria-expanded="false" data-help-page="survey-list" data-help-section="bridge-surveys">?</button>
        </h2>
      </div>
      <div id="survey-bridge-grid" class="grid"></div>
    </section>

    <section class="survey-listings__section is-hidden" id="survey-coming-section" aria-labelledby="survey-coming-title">
      <div class="survey-listings__header">
        <h2 id="survey-coming-title">
          Coming soon
          <button class="section-help-trigger" type="button" aria-label="Help: coming soon surveys" aria-expanded="false" data-help-page="survey-list" data-help-section="coming-soon">?</button>
        </h2>
      </div>
      <div id="survey-coming-grid" class="grid"></div>
    </section>
  </main>

  <Fragment slot="scripts">
    <script is:inline src="/js/survey-browser.js"></script>
    <script is:inline src="/js/surveys-list.js"></script>
  </Fragment>
</BaseLayout>
