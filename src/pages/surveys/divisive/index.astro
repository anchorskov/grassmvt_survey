---
// src/pages/surveys/divisive/index.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout title="Divisive Surveys | Grassroots Movement">
  <main
    class="survey-browse-page survey-browse-page--divisive"
    data-survey-browser-page
    data-survey-path="divisive"
    data-page-title="Divisive surveys"
  >
    <section class="survey-browse-page__hero" aria-labelledby="survey-browse-title">
      <p class="survey-browse-page__eyebrow">Divisive Surveys</p>
      <h1 id="survey-browse-title">Deeper topics and tradeoffs</h1>
      <p class="survey-browse-page__lede">
        These surveys cover issues that need more framing discipline, more context, and more room for tradeoffs
        before results are interpreted publicly.
      </p>
    </section>

    <section class="survey-path-picker" aria-labelledby="survey-path-picker-title">
      <div class="survey-path-picker__header">
        <h2 id="survey-path-picker-title">Switch paths</h2>
        <p class="helper-text" id="survey-auth-note">
          Browse topics now. <button class="link-button" type="button" data-auth-open="login">Sign in</button> when
          you are ready to save progress or edit responses.
        </p>
      </div>
      <div class="survey-path-picker__grid">
        <a class="survey-path-picker__card" href="/surveys/normal-life/" data-survey-path-link="normal-life">
          <span class="survey-path-picker__label">Normal Life Surveys</span>
          <strong>Short, fast, everyday issues.</strong>
          <span>Use this path for practical topics that should stay easy to browse and quick to answer.</span>
        </a>
        <a class="survey-path-picker__card" href="/surveys/divisive/" data-survey-path-link="divisive">
          <span class="survey-path-picker__label">Divisive Surveys</span>
          <strong>Deeper topics and tradeoffs.</strong>
          <span>Use this path when the topic is contentious, high-heat, or easy to oversimplify without context.</span>
        </a>
      </div>
    </section>

    <section class="survey-listings__section" id="survey-active-section" aria-labelledby="survey-active-title">
      <div class="survey-listings__header">
        <h2 id="survey-active-title">Active Divisive surveys</h2>
        <p class="helper-text" id="survey-active-intro"></p>
      </div>
      <div id="survey-active-grid" class="grid"></div>
    </section>

    <section class="survey-listings__section" id="survey-coming-soon-section" aria-labelledby="survey-coming-soon-title">
      <div class="survey-listings__header">
        <h2 id="survey-coming-soon-title">Divisive surveys coming soon</h2>
        <p class="helper-text" id="survey-coming-soon-intro"></p>
      </div>
      <div id="survey-coming-soon-grid" class="grid"></div>
    </section>
  </main>

  <Fragment slot="scripts">
    <script is:inline src="/js/survey-browser.js"></script>
    <script is:inline src="/js/surveys-list.js"></script>
  </Fragment>
</BaseLayout>
