---
// src/pages/surveys/results/index.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout title="Survey Results | Grassroots Movement">
  <style is:global>
    /* inline styles for results page — is:global required: bars are injected by survey-results.js */
    .results-selector {
      margin-bottom: 1.5rem;
      padding: 1rem;
      background: var(--color-surface-alt, #f8f9fa);
      border-radius: 8px;
    }
    .results-selector label {
      display: block;
      margin-bottom: 0.35rem;
      font-size: 0.875rem;
      font-weight: 700;
    }
    .results-selector select {
      width: min(100%, 420px);
      padding: 0.5rem;
      border: 1px solid var(--color-border, #ddd);
      border-radius: 4px;
      font-size: 0.875rem;
    }
    .results-selector .helper-text {
      margin-top: 0.5rem;
    }
    .results-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 1rem;
      font-size: 0.875rem;
      color: var(--color-text-muted, #666);
    }
    .results-badge {
      display: inline-flex;
      align-items: center;
      padding: 0.25rem 0.5rem;
      border-radius: 4px;
      background: #f1ece1; /* wy-bone */
      color: #2b2b2b;      /* wy-charcoal */
      font-size: 0.75rem;
      font-weight: 500;
    }
    /* tier — charcoal chip, high contrast anchor */
    .results-badge--tier { background: #2b2b2b; color: #fff; }
    /* geo — warm sandstone tint, rust text */
    .results-badge--geo  { background: #f5e6d0; color: #8a3d23; }
    /* n count — sage tint, dark sage text */
    .results-badge--n    { background: #e8ede4; color: #4a5c3a; }
    .results-controls {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      margin-bottom: 1.5rem;
      padding: 1rem;
      background: var(--color-surface-alt, #f8f9fa);
      border-radius: 8px;
    }
    .results-controls .control-group {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .results-controls__hint {
      margin: 0;
      font-size: 0.75rem;
      color: var(--color-text-muted, #666);
      font-style: italic;
    }
    .results-section-heading {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      width: 100%;
      margin: 0 0 0.75rem;
    }
    .results-section-heading h3,
    .results-section-heading h4,
    .results-section-heading p { margin: 0; }
    .results-section-heading__label {
      font-size: 0.875rem;
      font-weight: 700;
      color: var(--color-text, #1a1a1a);
    }
    .results-controls label {
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      color: var(--color-text-muted, #666);
    }
    .results-controls select {
      padding: 0.5rem;
      border: 1px solid var(--color-border, #ddd);
      border-radius: 4px;
      font-size: 0.875rem;
      min-width: 180px;
    }
    .results-suppressed {
      padding: 2rem;
      text-align: center;
      background: #fef3c7;
      border-radius: 8px;
      margin-bottom: 1.5rem;
    }
    .results-suppressed h3 { margin: 0 0 0.5rem; color: #92400e; }
    .results-suppressed p { margin: 0; color: #78350f; }
    .results-question {
      margin-bottom: 2rem;
      padding: 1rem;
      background: var(--color-surface, #fff);
      border: 1px solid var(--color-border, #ddd);
      border-radius: 8px;
    }
    .results-question h3 { margin: 0 0 1rem; font-size: 1rem; }
    .results-bar {
      display: flex;
      align-items: center;
      margin-bottom: 0.5rem;
    }
    .results-bar-label {
      flex: 0 0 40%;
      padding-right: 0.75rem;
      font-size: 0.875rem;
      word-break: break-word;
    }
    .results-bar-track {
      flex: 1;
      height: 24px;
      background: #e5e7eb;
      border-radius: 4px;
      overflow: hidden;
      position: relative;
    }
    .results-bar-fill {
      height: 100%;
      background: linear-gradient(90deg, #3b82f6, #1d4ed8);
      border-radius: 4px;
      transition: width 0.3s ease;
    }
    .results-bar-value {
      flex: 0 0 auto;
      padding-left: 0.75rem;
      font-size: 0.875rem;
      font-weight: 600;
      min-width: 80px;
      text-align: right;
    }
    .voter-panel {
      margin-top: 2rem;
      padding: 1rem;
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
      border-radius: 8px;
    }
    .voter-panel h4 { margin: 0 0 0.5rem; font-size: 0.875rem; color: #166534; }
    .voter-panel ul { margin: 0; padding-left: 1.25rem; font-size: 0.875rem; color: #15803d; }
    .voter-panel .note { margin-top: 0.5rem; font-size: 0.75rem; color: #166534; font-style: italic; }
    .user-district-panel {
      margin-bottom: 1.5rem;
      padding: 1rem;
      background: #f1ece1; /* wy-bone */
      border: 1px solid #d4c9b5;
      border-radius: 8px;
    }
    .user-district-panel h4 { margin: 0 0 0.75rem; font-size: 0.875rem; color: #2b2b2b; font-weight: 700; }
    /* rep cards row */
    .ud-cards {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    .ud-card {
      flex: 1 1 220px;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      padding: 0.75rem;
      background: #fff;
      border: 1px solid #d4c9b5;
      border-radius: 6px;
    }
    .ud-card--active {
      border-color: #8a3d23; /* wy-rust */
      background: #fdf6ef;
    }
    .ud-card__label {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: #8a3d23; /* wy-rust */
    }
    .ud-card__rep {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      flex: 1;
    }
    .ud-rep-name {
      font-size: 0.9rem;
      font-weight: 600;
      color: #2b2b2b;
    }
    .ud-rep-name--unknown {
      font-weight: 400;
      font-style: italic;
      color: #888;
    }
    .ud-rep-meta {
      font-size: 0.75rem;
      color: #666;
    }
    .ud-card__btn {
      margin-top: 0.5rem;
      padding: 0.35rem 0.75rem;
      background: #2b2b2b; /* wy-charcoal */
      color: #fff;
      border: none;
      border-radius: 4px;
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      text-align: center;
      align-self: flex-start;
    }
    .ud-card--active .ud-card__btn {
      background: #8a3d23; /* wy-rust — active state */
    }
    .ud-card__btn:hover { opacity: 0.85; }
    .results-loading { text-align: center; padding: 3rem; color: var(--color-text-muted, #666); }
    .results-error { padding: 2rem; text-align: center; background: #fef2f2; border-radius: 8px; color: #991b1b; }
    @media (max-width: 600px) {
      .results-bar { flex-wrap: wrap; }
      .results-bar-label { flex: 0 0 100%; padding-right: 0; margin-bottom: 0.25rem; }
      .results-bar-track { flex: 1; }
    }
  </style>

  <main>
    <section class="results-selector" aria-labelledby="results-survey-label">
      <label id="results-survey-label" for="results-survey-select">Select a survey</label>
      <select id="results-survey-select">
        <option value="">Choose a survey</option>
      </select>
      <p class="helper-text">Select a survey to review results.</p>
    </section>
    <div id="results-container">
      <div class="results-loading">Loading available surveys...</div>
    </div>
  </main>

  <Fragment slot="scripts">
    <script is:inline src="/js/survey-results.js"></script>
  </Fragment>
</BaseLayout>
