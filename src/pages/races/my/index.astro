---
// src/pages/races/my/index.astro
// Static shell — all personalized content loaded client-side via /api/races/my.
// /api/races/my uses the existing session cookie, getSessionUser, and
// getAddressVerification — no extra auth wiring needed here.
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="My Wyoming Races | Grassroots Movement"
  description="See the Wyoming races connected to your verified voting area and share public sentiment through short support polls."
>
  <main>

    {/* ── Hero ── */}
    <section class="bg-wy-charcoal text-white" aria-labelledby="my-races-title">
      <div class="mx-auto max-w-5xl px-6 py-16 md:py-20">
        <p class="mb-3 text-xs font-bold uppercase tracking-widest text-wy-sandstone">Your races</p>
        <h1 id="my-races-title" class="mb-5 font-serif text-4xl font-bold leading-tight md:text-5xl">
          Your Wyoming Races
        </h1>
        <p class="mb-6 max-w-3xl text-lg leading-relaxed text-white/85">
          Showing races connected to your verified voting area. Results are reported in aggregate only.
          Individual responses remain confidential.
        </p>
        <a class="button button--secondary border-white/40 text-white hover:bg-white/10" href="/races#browse-all">
          Browse all Wyoming races
        </a>
      </div>
    </section>

    {/* ── Race list — populated by JS ── */}
    <section class="bg-white" aria-labelledby="my-races-list-title">
      <div class="mx-auto max-w-6xl px-6 py-14 md:py-16">
        <h2 id="my-races-list-title" class="sr-only">Race list</h2>
        <div id="my-races-root">
          <p class="text-wy-charcoal/60">Loading your races&hellip;</p>
        </div>
      </div>
    </section>

    {/* ── How verification protects poll integrity ── */}
    <section class="bg-wy-bone" aria-labelledby="verification-info-title">
      <div class="mx-auto max-w-5xl px-6 py-14 md:py-16">
        <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-wy-rust">Verification and privacy</p>
        <h2 id="verification-info-title" class="mb-6 font-serif text-2xl font-bold text-wy-charcoal">
          How verification protects poll integrity
        </h2>
        <ul class="space-y-3 text-wy-charcoal/80 max-w-3xl">
          <li class="flex gap-3"><span class="mt-1 text-wy-rust font-bold flex-shrink-0">&#x2022;</span><span>We use voter verification to match citizens with races in their voting area.</span></li>
          <li class="flex gap-3"><span class="mt-1 text-wy-rust font-bold flex-shrink-0">&#x2022;</span><span>The current verification file reflects Wyoming registered voter records from August 2025.</span></li>
          <li class="flex gap-3"><span class="mt-1 text-wy-rust font-bold flex-shrink-0">&#x2022;</span><span>Verification helps reduce duplicate or out-of-area responses.</span></li>
          <li class="flex gap-3"><span class="mt-1 text-wy-rust font-bold flex-shrink-0">&#x2022;</span><span>Individual responses remain confidential and are never published.</span></li>
          <li class="flex gap-3"><span class="mt-1 text-wy-rust font-bold flex-shrink-0">&#x2022;</span><span>Results are reported in aggregate only.</span></li>
          <li class="flex gap-3"><span class="mt-1 text-wy-rust font-bold flex-shrink-0">&#x2022;</span><span>Verified and unverified results may be shown separately where available.</span></li>
          <li class="flex gap-3"><span class="mt-1 text-wy-rust font-bold flex-shrink-0">&#x2022;</span><span>This is a public sentiment poll, not an election prediction.</span></li>
        </ul>
      </div>
    </section>

    {/* ── Stay connected — informational only, no form ── */}
    <section class="bg-white" aria-labelledby="stay-connected-title">
      <div class="mx-auto max-w-5xl px-6 py-12 md:py-14">
        <h2 id="stay-connected-title" class="mb-3 font-serif text-xl font-bold text-wy-charcoal">Stay connected</h2>
        <p class="max-w-2xl text-wy-charcoal/75">
          Email and text updates are optional and separate from verification.
          Participation in polling does not require opting in to any campaign or movement messages.
        </p>
      </div>
    </section>

  </main>
</BaseLayout>

<script is:inline src="/js/races.js"></script>
<script>
(function () {
  function init() {
    (window as any).RaceHub && (window as any).RaceHub.loadMyRaces('my-races-root');
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
