---
// src/pages/races/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';

const raceCards = [
  {
    title: 'U.S. Senate, Wyoming, 2026',
    category: 'Federal',
    description: 'Review candidate information and preview the support poll for Wyoming citizens.',
    href: '/races/us-senate-2026',
    active: true,
  },
  {
    title: 'U.S. House, Wyoming, 2026',
    category: 'Federal',
    description: 'A future race page for Wyoming public sentiment polling.',
    href: '#race-selector',
    active: false,
  },
  {
    title: 'Governor, Wyoming, 2026',
    category: 'Statewide',
    description: 'A future statewide race page for candidate review and aggregate sentiment.',
    href: '#race-selector',
    active: false,
  },
  {
    title: 'State Legislature',
    category: 'State Legislature',
    description: 'Future race cards can be organized by House and Senate district.',
    href: '#race-selector',
    active: false,
  },
  {
    title: 'County Offices',
    category: 'County',
    description: 'Future county race pages can be grouped by county and office.',
    href: '#race-selector',
    active: false,
  },
  {
    title: 'Local Boards',
    category: 'School Board or Local Board',
    description: 'Future local board races can focus on community-level accountability.',
    href: '#race-selector',
    active: false,
  },
  {
    title: 'Judicial Retention',
    category: 'Judicial Retention',
    description: 'Future retention pages can collect neutral public sentiment and questions.',
    href: '#race-selector',
    active: false,
  },
];
---

<BaseLayout title="Wyoming 2026 Race Polls | Grassroots Movement" description="Choose a Wyoming race, review candidate information, and share public sentiment through short public polls.">
  <main>
    <section class="bg-wy-charcoal text-white" aria-labelledby="race-hero-title">
      <div class="mx-auto max-w-5xl px-6 py-16 md:py-20">
        <p class="mb-3 text-xs font-bold uppercase tracking-widest text-wy-sandstone">Public sentiment by race</p>
        <h1 id="race-hero-title" class="mb-5 font-serif text-4xl font-bold leading-tight md:text-5xl">Wyoming 2026 Race Polls</h1>
        <p class="max-w-3xl text-lg leading-relaxed text-white/85">
          Choose a race, review the candidates, and share where we stand. Results are reported in aggregate so citizens, candidates, and communities can see public sentiment by race.
        </p>
      </div>
    </section>

    <section class="bg-white" aria-labelledby="race-purpose-title">
      <div class="mx-auto max-w-5xl px-6 py-12 md:py-14">
        <h2 id="race-purpose-title" class="mb-4 font-serif text-2xl font-bold text-wy-charcoal">Race polling with a clear purpose</h2>
        <p class="max-w-4xl text-lg leading-relaxed text-wy-charcoal/80">
          GrassrootsMVT gives Wyoming citizens a simple way to follow races, review candidate information, and share where we stand through short public polls. The goal is accountability. We gather public input, report results in aggregate, and help candidates understand what citizens want addressed before asking for a vote.
        </p>
      </div>
    </section>

    <section class="bg-wy-bone" aria-labelledby="race-how-title">
      <div class="mx-auto max-w-5xl px-6 py-14 md:py-16">
        <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-wy-rust">How it works</p>
        <h2 id="race-how-title" class="mb-8 font-serif text-3xl font-bold text-wy-charcoal">Three simple steps</h2>
        <div class="grid gap-5 md:grid-cols-3">
          <article class="rounded-lg border border-wy-dust bg-white p-5">
            <p class="mb-2 text-sm font-bold uppercase tracking-widest text-wy-ember">01</p>
            <h3 class="mb-2 font-serif text-xl font-semibold text-wy-charcoal">Choose a race</h3>
            <p class="text-wy-charcoal/75">Start with the office or jurisdiction that matters to you.</p>
          </article>
          <article class="rounded-lg border border-wy-dust bg-white p-5">
            <p class="mb-2 text-sm font-bold uppercase tracking-widest text-wy-ember">02</p>
            <h3 class="mb-2 font-serif text-xl font-semibold text-wy-charcoal">Review candidates</h3>
            <p class="text-wy-charcoal/75">Use the same candidate information format for each person in the race.</p>
          </article>
          <article class="rounded-lg border border-wy-dust bg-white p-5">
            <p class="mb-2 text-sm font-bold uppercase tracking-widest text-wy-ember">03</p>
            <h3 class="mb-2 font-serif text-xl font-semibold text-wy-charcoal">Take the support poll</h3>
            <p class="text-wy-charcoal/75">Share support, opposition, uncertainty, unfamiliarity, and key questions.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="race-selector" class="bg-white" aria-labelledby="race-selector-title">
      <div class="mx-auto max-w-5xl px-6 py-14 md:py-16">
        <div class="mb-8 max-w-3xl">
          <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-wy-rust">Race selector</p>
          <h2 id="race-selector-title" class="mb-3 font-serif text-3xl font-bold text-wy-charcoal">Browse by race type</h2>
          <p class="text-wy-charcoal/75">The first version uses a simple selector. Future versions can filter by county, district, office, and election year.</p>
        </div>
        <label class="block max-w-xl" for="race-category">
          <span class="mb-2 block text-sm font-bold uppercase tracking-wide text-wy-charcoal">Race category</span>
          <select id="race-category" class="w-full rounded-md border border-wy-dust bg-white px-4 py-3 text-wy-charcoal shadow-sm">
            <option value="">All races</option>
            <option>Federal</option>
            <option>Statewide</option>
            <option>State Legislature</option>
            <option>County</option>
            <option>City or Town</option>
            <option>School Board or Local Board</option>
            <option>Judicial Retention</option>
          </select>
        </label>
      </div>
    </section>

    <section class="bg-wy-bone" aria-labelledby="race-cards-title">
      <div class="mx-auto max-w-6xl px-6 py-14 md:py-16">
        <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-wy-rust">Browse races</p>
        <h2 id="race-cards-title" class="mb-8 font-serif text-3xl font-bold text-wy-charcoal">Available and planned race pages</h2>
        <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3" id="race-cards-grid">
          {raceCards.map((race) => (
            <article class="flex min-h-64 flex-col rounded-lg border border-wy-dust bg-white p-5" data-category={race.category}>
              <p class="mb-2 text-xs font-bold uppercase tracking-widest text-wy-rust">{race.category}</p>
              <h3 class="mb-3 font-serif text-xl font-semibold leading-snug text-wy-charcoal">{race.title}</h3>
              <p class="mb-5 flex-1 text-wy-charcoal/75">{race.description}</p>
              <div class="flex flex-wrap gap-2">
                {race.active ? (
                  <>
                    <a class="button button--primary" href={`${race.href}#support-poll`}>Take Poll</a>
                    <a class="button button--secondary" href={`${race.href}#candidates`}>View Candidates</a>
                    <a class="button button--secondary" href={`${race.href}#results`}>View Results</a>
                  </>
                ) : (
                  <span class="inline-block rounded-md border border-wy-dust bg-wy-bone px-3 py-2 text-sm font-semibold text-wy-charcoal/60">Coming soon</span>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
(function () {
  const sel = document.getElementById('race-category');
  const grid = document.getElementById('race-cards-grid');
  if (!sel || !grid) return;
  sel.addEventListener('change', function () {
    const chosen = sel.value;
    grid.querySelectorAll('article[data-category]').forEach(function (card) {
      const match = !chosen || card.getAttribute('data-category') === chosen;
      (card as HTMLElement).style.display = match ? '' : 'none';
    });
  });
})();
</script>
