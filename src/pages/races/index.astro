---
// src/pages/races/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';

const raceCards = [
  {
    title: 'U.S. Senate, Wyoming, 2026',
    category: 'Federal',
    description: 'Review candidate information and share public sentiment through a short support poll.',
    href: '/races/us-senate-2026',
    raceSlug: 'us-senate-2026',
  },
  {
    title: 'U.S. House, Wyoming, 2026',
    category: 'Federal',
    description: 'Review candidate information and share public sentiment for Wyoming\'s at-large House seat.',
    href: '/races/us-house-2026',
    raceSlug: 'us-house-2026',
  },
  {
    title: 'Governor, Wyoming, 2026',
    category: 'Statewide',
    description: 'Review candidate information and share public sentiment for the Wyoming gubernatorial race.',
    href: '/races/governor-2026',
    raceSlug: 'governor-2026',
  },
  {
    title: 'Wyoming Statewide Offices, 2026',
    category: 'Statewide',
    description: 'Secretary of State, Treasurer, Auditor, and Superintendent of Public Instruction.',
    href: '/races/statewide-offices-2026',
    raceSlug: null,
  },
  {
    title: 'Wyoming State Legislature, 2026',
    category: 'State Legislature',
    description: 'State House and State Senate district races organized by district number.',
    href: '/races/state-legislature-2026',
    raceSlug: null,
  },
  {
    title: 'Wyoming County Offices, 2026',
    category: 'County',
    description: 'County commission, clerk, sheriff, treasurer, and attorney races across Wyoming\'s 23 counties.',
    href: '/races/county-offices-2026',
    raceSlug: null,
  },
  {
    title: 'Wyoming Local Boards, 2026',
    category: 'Local Board',
    description: 'School boards, city and town councils, special districts, and other local boards.',
    href: '/races/local-boards-2026',
    raceSlug: null,
  },
  {
    title: 'Wyoming Judicial Retention, 2026',
    category: 'Judicial Retention',
    description: 'Public sentiment on whether Wyoming justices and judges should be retained.',
    href: '/races/judicial-retention-2026',
    raceSlug: null,
  },
];
---

<BaseLayout title="Find Your Candidates | Wyoming 2026 | Grassroots Movement" description="Find candidates connected to your Wyoming voting area, including statewide races, State House, State Senate, and county offices where available.">
  <main>

    {/* ── Hero ── */}
    <section class="bg-wy-charcoal text-white" aria-labelledby="races-hero-title">
      <div class="mx-auto max-w-5xl px-6 py-16 md:py-20">
        <p class="mb-3 text-xs font-bold uppercase tracking-widest text-wy-sandstone">Wyoming 2026 races</p>
        <h1 id="races-hero-title" class="mb-5 font-serif text-4xl font-bold leading-tight md:text-5xl">
          Find Your Candidates
        </h1>
        <p class="mb-8 max-w-3xl text-lg leading-relaxed text-white/85">
          Find candidates connected to your Wyoming voting area, including statewide races, State House, State Senate, and county offices where available.
        </p>
        <div class="flex flex-wrap gap-3 mb-10">
          <a class="button button--primary" href="/races/my">Find My Candidates</a>
          <a class="button button--secondary border-white/40 text-white hover:bg-white/10" href="#browse-all">Browse All Wyoming Races</a>
        </div>
        <div class="max-w-3xl rounded-lg border border-white/15 bg-white/8 px-5 py-4 text-sm text-white/75 leading-relaxed">
          We use voter verification or address lookup to match you with candidates connected to your voting area.
          Individual responses remain confidential. Results are reported in aggregate.
        </div>
      </div>
    </section>

    {/* ── How it works ── */}
    <section class="bg-wy-bone" aria-labelledby="race-how-title">
      <div class="mx-auto max-w-5xl px-6 py-14 md:py-16">
        <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-wy-rust">How it works</p>
        <h2 id="race-how-title" class="mb-8 font-serif text-3xl font-bold text-wy-charcoal">Three simple steps</h2>
        <div class="grid gap-5 md:grid-cols-3">
          <article class="rounded-lg border border-wy-dust bg-white p-5">
            <p class="mb-2 text-sm font-bold uppercase tracking-widest text-wy-ember">01</p>
            <h3 class="mb-2 font-serif text-xl font-semibold text-wy-charcoal">Find your candidates</h3>
            <p class="text-wy-charcoal/75">Enter your name and ZIP code — or verify your voter information — to see candidates connected to your House district, Senate district, and statewide races.</p>
          </article>
          <article class="rounded-lg border border-wy-dust bg-white p-5">
            <p class="mb-2 text-sm font-bold uppercase tracking-widest text-wy-ember">02</p>
            <h3 class="mb-2 font-serif text-xl font-semibold text-wy-charcoal">Review candidates</h3>
            <p class="text-wy-charcoal/75">Use the same candidate information format for each person in the race.</p>
          </article>
          <article class="rounded-lg border border-wy-dust bg-white p-5">
            <p class="mb-2 text-sm font-bold uppercase tracking-widest text-wy-ember">03</p>
            <h3 class="mb-2 font-serif text-xl font-semibold text-wy-charcoal">Take the support poll</h3>
            <p class="text-wy-charcoal/75">Share support, opposition, uncertainty, unfamiliarity, and key questions.</p>
          </article>
        </div>
      </div>
    </section>

    {/* ── Race selector ── */}
    <section class="bg-white" aria-labelledby="race-selector-title">
      <div class="mx-auto max-w-5xl px-6 py-14 md:py-16">
        <div class="mb-8 max-w-3xl">
          <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-wy-rust">Race selector</p>
          <h2 id="race-selector-title" class="mb-3 font-serif text-3xl font-bold text-wy-charcoal">Browse by race type</h2>
          <p class="text-wy-charcoal/75">Filter race cards by category. Future versions can also filter by county, district, office, and election year.</p>
        </div>
        <label class="block max-w-xl" for="race-category">
          <span class="mb-2 block text-sm font-bold uppercase tracking-wide text-wy-charcoal">Race category</span>
          <select id="race-category" class="w-full rounded-md border border-wy-dust bg-white px-4 py-3 text-wy-charcoal shadow-sm">
            <option value="">All races</option>
            <option>Federal</option>
            <option>Statewide</option>
            <option>State Legislature</option>
            <option>County</option>
            <option>Local Board</option>
            <option>Judicial Retention</option>
          </select>
        </label>
      </div>
    </section>

    {/* ── Race cards grid ── */}
    <section id="browse-all" class="bg-wy-bone" aria-labelledby="race-cards-title">
      <div class="mx-auto max-w-6xl px-6 py-14 md:py-16">
        <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-wy-rust">Browse races</p>
        <h2 id="race-cards-title" class="mb-8 font-serif text-3xl font-bold text-wy-charcoal">Available race pages</h2>
        <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3" id="race-cards-grid">
          {raceCards.map((race) => (
            <article class="flex min-h-64 flex-col rounded-lg border border-wy-dust bg-white p-5" data-category={race.category} data-race-slug={race.raceSlug}>
              <p class="mb-2 text-xs font-bold uppercase tracking-widest text-wy-rust">{race.category}</p>
              <h3 class="mb-3 font-serif text-xl font-semibold leading-snug text-wy-charcoal">{race.title}</h3>
              <p class="mb-4 flex-1 text-wy-charcoal/75">{race.description}</p>
              <p class="mb-4 race-candidate-count is-hidden text-xs font-semibold text-wy-charcoal/60"></p>
              {race.raceSlug ? (
                // Individual pollable race — show all three actions
                <div class="flex flex-wrap gap-2">
                  <a class="button button--primary" href={`${race.href}#support-poll`}>Take Poll</a>
                  <a class="button button--secondary" href={`${race.href}#candidates`}>View Candidates</a>
                  <a class="button button--secondary" href={`${race.href}#results`}>View Results</a>
                </div>
              ) : (
                // Group / category page — navigate to browse
                <div class="flex flex-wrap gap-2">
                  <a class="button button--primary" href={race.href}>Browse Races</a>
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<script is:inline src="/js/races.js"></script>
<script>
(function () {
  const sel = document.getElementById('race-category');
  const grid = document.getElementById('race-cards-grid');
  if (sel && grid) {
    sel.addEventListener('change', function () {
      const chosen = (sel as HTMLSelectElement).value;
      grid.querySelectorAll('article[data-category]').forEach(function (card) {
        const match = !chosen || card.getAttribute('data-category') === chosen;
        (card as HTMLElement).style.display = match ? '' : 'none';
      });
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { (window as any).RaceHub && (window as any).RaceHub.enrichHubCards(); });
  } else {
    (window as any).RaceHub && (window as any).RaceHub.enrichHubCards();
  }
})();
</script>
