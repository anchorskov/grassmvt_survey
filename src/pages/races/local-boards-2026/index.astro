---
// src/pages/races/local-boards-2026/index.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CandidateCard from '../../../components/races/CandidateCard.astro';
import SupportPollPreview from '../../../components/races/SupportPollPreview.astro';
import {
  LOCAL_BOARDS_2026_CARDS,
  SUPPORT_CHOICES,
  SUPPORT_QUESTION,
  RACE_POLL_QUESTIONS,
} from '../../../data/races.js';
---

<BaseLayout title="Wyoming Local Boards, 2026 | Grassroots Movement" description="Review board information and share public sentiment for Wyoming school boards, city councils, and local district races in 2026.">
  <main>
    <section class="bg-wy-charcoal text-white" aria-labelledby="race-title">
      <div class="mx-auto max-w-5xl px-6 py-16 md:py-20">
        <p class="mb-3 text-xs font-bold uppercase tracking-widest text-wy-sandstone">Local boards</p>
        <h1 id="race-title" class="mb-5 font-serif text-4xl font-bold leading-tight md:text-5xl">Wyoming Local Boards, 2026</h1>
        <p class="mb-8 max-w-3xl text-lg leading-relaxed text-white/85">
          Wyoming's local boards cover school districts, city and town councils, special districts, and other community governance. This page will gather public input by board and community as candidates are confirmed.
        </p>
        <div class="flex flex-wrap gap-3">
          <a class="button button--primary" href="#support-poll">View Poll Preview</a>
          <a class="button button--secondary border-white/40 text-white hover:bg-white/10" href="#candidates">Review Board Cards</a>
        </div>
      </div>
    </section>

    <section id="candidates" class="bg-white" aria-labelledby="boards-title">
      <div class="mx-auto max-w-6xl px-6 py-14 md:py-16">
        <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-wy-rust">Board information</p>
        <h2 id="boards-title" class="mb-3 font-serif text-3xl font-bold text-wy-charcoal">Local board cards</h2>
        <p class="mb-8 max-w-3xl text-wy-charcoal/75">
          Candidate information will be organized by board and community after verified public-source review. Each board will have its own candidate support poll once candidates are confirmed.
        </p>
        <div class="grid gap-5 md:grid-cols-2" id="boards-grid">
          {LOCAL_BOARDS_2026_CARDS.map((c) => (
            <CandidateCard
              name={c.name}
              office={c.office}
              status={c.status}
              statement={c.statement}
              sourceNote={c.sourceNote}
            />
          ))}
        </div>
      </div>
    </section>

    <section id="support-poll" class="bg-wy-bone" aria-labelledby="poll-title">
      <div class="mx-auto max-w-5xl px-6 py-14 md:py-16">
        <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-wy-rust">Poll preview</p>
        <h2 id="poll-title" class="mb-4 font-serif text-3xl font-bold text-wy-charcoal">Candidate support poll</h2>
        <p class="mb-8 max-w-3xl text-wy-charcoal/75">
          Candidate support polls will be available here by board and community once candidates are confirmed. Each poll will use the standard support question and answer scale.
        </p>
        <SupportPollPreview
          candidates={[]}
          choices={SUPPORT_CHOICES}
          questionText={SUPPORT_QUESTION}
          pollQuestions={RACE_POLL_QUESTIONS}
        />
      </div>
    </section>

    <section id="results" class="bg-white" aria-labelledby="results-title">
      <div class="mx-auto max-w-6xl px-6 py-14 md:py-16">
        <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-wy-rust">Results concept</p>
        <h2 id="results-title" class="mb-4 font-serif text-3xl font-bold text-wy-charcoal">Aggregate sentiment</h2>
        <p class="mb-4 inline-block rounded-md border border-wy-dust bg-wy-bone px-4 py-3 font-semibold text-wy-charcoal">
          This is a public sentiment poll, not an election prediction.
        </p>
        <p class="text-wy-charcoal/75">
          Aggregate results will be displayed here by board, community, and candidate once polls are active and candidates are confirmed.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline src="/js/races.js"></script>
<script>
(function () {
  async function loadLocalRaces() {
    const grid = document.getElementById('boards-grid');
    if (!grid) return;
    let data;
    try {
      const res = await fetch('/api/races');
      if (!res.ok) return;
      data = await res.json();
    } catch (_e) { return; }
    const races = (data.races || []).filter(function (r) {
      return r.race_category === 'Local Board';
    });
    if (races.length === 0) return;
    function escH(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
    grid.innerHTML = races.map(function (r) {
      const count = r.candidate_count === 1 ? '1 candidate' : r.candidate_count + ' candidates';
      return (
        '<article class="rounded-lg border border-wy-dust bg-wy-bone/40 p-5">' +
        '<h3 class="mb-2 font-serif text-lg font-semibold text-wy-charcoal">' + escH(r.race_title) + '</h3>' +
        '<p class="mb-3 text-sm text-wy-charcoal/70">' + escH(count) + '</p>' +
        '<a class="button button--secondary text-sm" href="/races/' + encodeURIComponent(r.race_slug) + '">View race</a>' +
        '</article>'
      );
    }).join('');
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadLocalRaces);
  } else {
    loadLocalRaces();
  }
})();
</script>
