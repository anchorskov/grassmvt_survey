---
// src/pages/citizen-nonpartisan-ballot/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';

const shareText = 'Wyoming already has a nonpartisan ballot. Let\'s give it meaning. I support exploring a Citizen Nonpartisan Ballot so every voter has one meaningful primary ballot option without being forced to change affiliation. One voter. One ballot. One citizen path to November.';

const steps = [
  'Every voter chooses one ballot.',
  'Party ballots nominate party candidates.',
  'The Citizen Nonpartisan Ballot lists candidates for covered public offices.',
  'The highest Citizen Nonpartisan vote earner who is not already party-nominated may qualify for November if the threshold is met.',
];

const notDoing = [
  'It does not erase party ballots.',
  'It does not force anyone to change affiliation.',
  'It does not let one ballot control another ballot.',
  'It does not use Citizen Nonpartisan votes to choose party nominees.',
];

const surveyQuestions = [
  'Should Wyoming expand the existing nonpartisan ballot so every voter has a meaningful primary ballot option?',
  'Should each voter choose only one ballot?',
  'Should the Citizen Nonpartisan Ballot include candidates for public office who already appear on party primary ballots?',
  'Should the highest Citizen Nonpartisan vote earner who is not already party-nominated qualify for the general election?',
  'What minimum threshold seems fair: 5%, 10%, 15%, 20%, no threshold, or unsure?',
  'What concerns should be addressed before legislation is filed?',
];

const faqs = [
  {
    q: 'Does this remove party ballots?',
    a: 'No. Party ballots remain and continue to nominate party candidates.',
  },
  {
    q: 'Does this force voters to change affiliation?',
    a: 'No. The point is to give voters a meaningful option without forced affiliation.',
  },
  {
    q: 'Does the Citizen Nonpartisan Ballot choose party nominees?',
    a: 'No. Party ballots choose party nominees. The Citizen Nonpartisan Ballot creates a separate citizen path.',
  },
  {
    q: 'Could this place a third candidate on the general election ballot?',
    a: 'Yes, if the highest eligible Citizen Nonpartisan vote earner is not already party-nominated and meets the threshold.',
  },
  {
    q: 'Is this final legislation?',
    a: 'No. This is a public proposal. The survey will help refine the draft.',
  },
];
---

<BaseLayout
  title="Citizen Nonpartisan Ballot | Wyoming Voter Choice"
  description="A proposal to expand Wyoming's existing nonpartisan ballot so every voter has one meaningful primary ballot option and one citizen path to November."
>
  <main class="cnb-page">
    <section class="relative flex min-h-[560px] items-end overflow-hidden md:min-h-[680px]" aria-labelledby="cnb-hero-title">
      <picture class="absolute inset-0 h-full w-full">
        <img
          src="/images/wyoming-sunrise.png"
          alt=""
          role="presentation"
          width="1536"
          height="1024"
          class="h-full w-full object-cover object-center"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/60 to-black/15 md:bg-gradient-to-r md:from-black/85 md:via-black/55 md:to-black/10"></div>
      <div class="relative z-10 w-full">
        <div class="mx-auto max-w-6xl px-6 py-14 md:py-20">
          <div class="max-w-3xl">
            <p class="mb-3 text-xs font-bold uppercase tracking-widest text-wy-sandstone">Citizen Nonpartisan Ballot</p>
            <h1 id="cnb-hero-title" class="mb-5 font-serif text-4xl font-bold leading-tight text-white md:text-5xl lg:text-6xl">
              One voter. One ballot. One citizen path to November.
            </h1>
            <p class="mb-8 max-w-2xl text-lg leading-relaxed text-white/85 md:text-xl">
              Wyoming already has a nonpartisan ballot. Let&rsquo;s give it meaning by allowing every voter to choose a Citizen Nonpartisan Ballot without being forced to declare or change party affiliation.
            </p>
            <div class="flex flex-wrap gap-3">
              <a class="button button--primary" href="#survey">Take the Survey</a>
              <a class="button button--secondary border-white/40 text-white hover:bg-white/10" href="#proposal">Read the Proposal</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="proposal" class="bg-wy-bone" aria-labelledby="problem-title">
      <div class="mx-auto grid max-w-6xl gap-8 px-6 py-14 md:grid-cols-2 md:py-16">
        <article class="rounded-lg border border-wy-dust bg-white p-6">
          <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-wy-rust">The Problem</p>
          <h2 id="problem-title" class="mb-4 font-serif text-3xl font-bold text-wy-charcoal">Too many voters face a forced choice.</h2>
          <p class="text-lg leading-relaxed text-wy-charcoal/80">
            Many Wyoming voters do not want to change affiliation just to have a meaningful voice in the primary. The existing nonpartisan ballot is available, but for many voters it does not provide a meaningful choice in major public offices.
          </p>
        </article>
        <article class="rounded-lg border border-wy-dust bg-white p-6">
          <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-wy-rust">The Solution</p>
          <h2 class="mb-4 font-serif text-3xl font-bold text-wy-charcoal">Give the nonpartisan ballot meaning.</h2>
          <p class="text-lg leading-relaxed text-wy-charcoal/80">
            Expand the existing nonpartisan ballot into a Citizen Nonpartisan Ballot. Voters would choose one ballot: a party ballot or the Citizen Nonpartisan Ballot. Party ballots still nominate party candidates. The Citizen Nonpartisan Ballot creates one citizen path to the general election.
          </p>
        </article>
      </div>
    </section>

    <section class="bg-white" aria-labelledby="how-works-title">
      <div class="mx-auto max-w-6xl px-6 py-14 md:py-16">
        <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-wy-rust">How It Works</p>
        <h2 id="how-works-title" class="mb-8 font-serif text-3xl font-bold text-wy-charcoal">One ballot choice, one clear path.</h2>
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
          {steps.map((step, index) => (
            <article class="rounded-lg border border-wy-dust bg-wy-bone p-5">
              <p class="mb-3 text-sm font-bold uppercase tracking-widest text-wy-ember">Step {index + 1}</p>
              <p class="text-lg font-semibold leading-snug text-wy-charcoal">{step}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-wy-bone" aria-labelledby="not-do-title">
      <div class="mx-auto grid max-w-6xl gap-8 px-6 py-14 md:grid-cols-[0.85fr_1.15fr] md:py-16">
        <div>
          <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-wy-rust">What It Does Not Do</p>
          <h2 id="not-do-title" class="mb-4 font-serif text-3xl font-bold text-wy-charcoal">This keeps party ballots intact.</h2>
          <p class="text-lg leading-relaxed text-wy-charcoal/80">
            The proposal gives voters another meaningful primary ballot option. It does not replace party nomination, change party ballots, or let one ballot decide another ballot.
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {notDoing.map((item) => (
            <article class="rounded-lg border border-wy-dust bg-white p-5">
              <p class="mb-2 text-sm font-bold uppercase tracking-widest text-wy-ember">No</p>
              <p class="text-wy-charcoal/85">{item}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-wy-charcoal text-white" aria-labelledby="adds-title">
      <div class="mx-auto max-w-4xl px-6 py-14 md:py-16">
        <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-wy-sandstone">What It Adds</p>
        <h2 id="adds-title" class="mb-4 font-serif text-3xl font-bold">A meaningful option for every voter.</h2>
        <p class="text-xl leading-relaxed text-white/85">
          It gives every voter one meaningful primary ballot option and gives the people one citizen path to November.
        </p>
      </div>
    </section>

    <section class="bg-white" aria-labelledby="example-title">
      <div class="mx-auto max-w-5xl px-6 py-14 md:py-16">
        <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-wy-rust">Example</p>
        <h2 id="example-title" class="mb-8 font-serif text-3xl font-bold text-wy-charcoal">How a November ballot could look.</h2>
        <div class="rounded-lg border border-wy-dust bg-wy-bone p-6 md:p-8">
          <div class="grid gap-4 md:grid-cols-3">
            <article class="rounded-lg bg-white p-5">
              <p class="mb-2 text-xs font-bold uppercase tracking-widest text-wy-rust">Party ballot</p>
              <p class="font-serif text-2xl font-bold text-wy-charcoal">Smith wins</p>
            </article>
            <article class="rounded-lg bg-white p-5">
              <p class="mb-2 text-xs font-bold uppercase tracking-widest text-wy-rust">Party ballot</p>
              <p class="font-serif text-2xl font-bold text-wy-charcoal">Jones wins</p>
            </article>
            <article class="rounded-lg bg-white p-5">
              <p class="mb-2 text-xs font-bold uppercase tracking-widest text-wy-rust">Citizen Nonpartisan</p>
              <p class="font-serif text-2xl font-bold text-wy-charcoal">Garcia wins</p>
            </article>
          </div>
          <p class="mt-6 text-lg leading-relaxed text-wy-charcoal/80">
            If Garcia is not already party-nominated and meets the threshold, November includes Smith, Jones, and Garcia.
          </p>
          <p class="mt-4 rounded-lg border border-wy-dust bg-white p-4 text-wy-charcoal/80">
            Duplicate rule: If the Citizen Nonpartisan winner is already party-nominated, the next highest Citizen Nonpartisan vote earner may qualify if the threshold is met.
          </p>
        </div>
      </div>
    </section>

    <section id="survey" class="bg-wy-bone" aria-labelledby="survey-title">
      <div class="mx-auto grid max-w-6xl gap-8 px-6 py-14 md:grid-cols-[0.85fr_1.15fr] md:py-16">
        <div>
          <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-wy-rust">Survey</p>
          <h2 id="survey-title" class="mb-4 font-serif text-3xl font-bold text-wy-charcoal">Help Shape the Proposal</h2>
          <p class="mb-6 text-lg leading-relaxed text-wy-charcoal/80">
            Before legislation is drafted, we need to hear from Wyoming voters. Should we expand the existing nonpartisan ballot? What threshold should apply? What concerns should be addressed?
          </p>
          <a class="button button--primary" href="#survey">Take the Citizen Nonpartisan Ballot Survey</a>
        </div>
        <article class="rounded-lg border border-wy-dust bg-white p-6">
          <h3 class="mb-4 font-serif text-2xl font-bold text-wy-charcoal">Survey preview</h3>
          <ul class="space-y-3 text-wy-charcoal/80">
            {surveyQuestions.map((question) => (
              <li class="border-b border-wy-dust/50 pb-3 last:border-b-0 last:pb-0">{question}</li>
            ))}
          </ul>
        </article>
      </div>
    </section>

    <section class="bg-white" aria-labelledby="share-title">
      <div class="mx-auto max-w-5xl px-6 py-14 md:py-16">
        <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-wy-rust">Share</p>
        <h2 id="share-title" class="mb-6 font-serif text-3xl font-bold text-wy-charcoal">Share the idea.</h2>
        <div class="rounded-lg border border-wy-dust bg-wy-bone p-5">
          <label for="share-message" class="mb-2 block text-sm font-bold uppercase tracking-wide text-wy-charcoal">Copy-ready message</label>
          <textarea id="share-message" class="min-h-40 w-full rounded-md border border-wy-dust bg-white p-4 text-wy-charcoal" readonly>{shareText}</textarea>
          <p id="share-status" class="mt-3 min-h-6 text-sm font-semibold text-wy-rust" aria-live="polite"></p>
          <div class="mt-4 flex flex-wrap gap-3">
            <button id="copy-message" class="button button--primary" type="button">Copy Message</button>
            <button id="share-page" class="button button--secondary" type="button">Share This Page</button>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-wy-bone" aria-labelledby="faq-title">
      <div class="mx-auto max-w-4xl px-6 py-14 md:py-16">
        <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-wy-rust">FAQ</p>
        <h2 id="faq-title" class="mb-8 font-serif text-3xl font-bold text-wy-charcoal">Common questions</h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <details class="rounded-lg border border-wy-dust bg-white p-5">
              <summary class="cursor-pointer font-serif text-xl font-semibold text-wy-charcoal">{faq.q}</summary>
              <p class="mt-3 leading-relaxed text-wy-charcoal/80">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-wy-ember text-white" aria-labelledby="closing-title">
      <div class="mx-auto max-w-4xl px-6 py-14 text-center md:py-16">
        <h2 id="closing-title" class="mb-4 font-serif text-3xl font-bold md:text-4xl">Let Wyoming voters be heard.</h2>
        <p class="mx-auto mb-8 max-w-2xl text-lg leading-relaxed text-white/85">
          This proposal starts with a simple idea: keep party ballots, expand voter choice, and give the people one citizen path to November.
        </p>
        <div class="flex justify-center flex-wrap gap-3">
          <a class="button button--primary bg-white text-wy-ember hover:bg-wy-bone" href="#survey">Take the Survey</a>
          <a class="button button--secondary border-white text-white hover:bg-white/10" href="#share-title">Share the Idea</a>
        </div>
      </div>
    </section>
  </main>

  <script is:inline slot="scripts">
    (() => {
      const copyButton = document.getElementById('copy-message');
      const shareButton = document.getElementById('share-page');
      const message = document.getElementById('share-message');
      const status = document.getElementById('share-status');

      const setStatus = (text) => {
        if (status) status.textContent = text;
      };

      const getMessageText = () => message?.value || '';

      copyButton?.addEventListener('click', async () => {
        const text = getMessageText();
        try {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(text);
          } else if (message instanceof HTMLTextAreaElement) {
            message.focus();
            message.select();
            setStatus('Message selected. Use your browser copy command to copy it.');
            return;
          }
          setStatus('Message copied.');
        } catch (_error) {
          setStatus('Copy failed. Select the message text and copy it manually.');
        }
      });

      shareButton?.addEventListener('click', async () => {
        const text = getMessageText();
        const url = window.location.href;
        try {
          if (navigator.share) {
            await navigator.share({
              title: 'Citizen Nonpartisan Ballot',
              text,
              url,
            });
            setStatus('Share window opened.');
          } else {
            window.location.href = `mailto:?subject=${encodeURIComponent('Citizen Nonpartisan Ballot')}&body=${encodeURIComponent(`${text}\n\n${url}`)}`;
          }
        } catch (_error) {
          setStatus('Share canceled.');
        }
      });
    })();
  </script>
</BaseLayout>
