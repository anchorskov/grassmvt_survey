---
// src/pages/townhall/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Town Hall | Grassroots Movement">
  <main>
    <h1>Town Hall <button class="section-help-trigger" type="button" aria-label="Help: Town Hall" aria-expanded="false" data-help-page="townhall" data-help-section="overview">?</button></h1>
    <p class="helper-text">Discuss survey topics and review supporting receipts.</p>
    <p class="form-error is-hidden" id="townhall-list-error" role="alert"></p>
    <div id="townhall-topics" class="grid"></div>
  </main>

  <Fragment slot="scripts">
    <script is:inline src="/townhall/townhall.js"></script>
  </Fragment>
</BaseLayout>
