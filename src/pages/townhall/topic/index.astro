---
// src/pages/townhall/topic/index.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout title="Town Hall Topic | Grassroots Movement">
  <main>
    <p><a class="link-button" href="/townhall/">Back to Town Hall topics</a></p>
    <h1 id="topic-title">Town Hall topic</h1>
    <p class="helper-text" id="topic-description"></p>
    <p class="form-error is-hidden" id="topic-error" role="alert"></p>

    <section class="card is-hidden" id="topic-missing">
      <h2 id="topic-missing-title">Town Hall not enabled yet</h2>
      <p id="topic-missing-body">This survey does not have a Town Hall topic yet.</p>
      <p class="card__actions">
        <a class="button button--small button--secondary" href="/surveys/list/">Back to surveys list</a>
        <a class="button button--small button--secondary" href="/townhall/">Town Hall home</a>
      </p>
      <p class="card__actions">
        <button class="button button--small is-hidden" id="enable-topic-btn" type="button">
          Enable Town Hall for this survey
        </button>
      </p>
      <p class="form-error is-hidden" id="enable-topic-error" role="alert"></p>
    </section>

    <section class="townhall-layout">
      <div class="townhall-main">
        <section class="card is-hidden" id="compose-card">
          <h2>Add your statement or idea.</h2>
          <form id="compose-form" class="survey-form" novalidate>
            <div class="form-row">
              <div class="form-label-row">
                <label for="statement-body">Statement</label>
                <button
                  class="section-help-trigger"
                  type="button"
                  data-help-page="townhall-topic"
                  data-help-section="statement"
                  aria-label="Help: Statement"
                  aria-expanded="false"
                >?</button>
              </div>
              <textarea
                id="statement-body"
                maxlength="500"
                required
                placeholder="Share your position clearly and briefly. Include a source link below if it helps others verify your point."
              ></textarea>
              <p class="helper-text statement-counter-row">
                <span>Text only, 500 characters max. Keep it civil. No threats, slurs, harassment, or personal abuse.</span>
                <span id="statement-counter" aria-live="polite">0 / 500</span>
              </p>
            </div>
            <div class="form-row">
              <div class="form-label-row">
                <label for="statement-tags">Tags (optional, comma separated)</label>
                <button
                  class="section-help-trigger"
                  type="button"
                  data-help-page="townhall-topic"
                  data-help-section="tags"
                  aria-label="Help: Tags"
                  aria-expanded="false"
                >?</button>
              </div>
              <input id="statement-tags" type="text" maxlength="120" placeholder="costs, access" />
            </div>
            <fieldset class="form-row statement-sources">
              <legend class="form-label-row">
                <span>Sources (optional)</span>
                <button
                  class="section-help-trigger"
                  type="button"
                  data-help-page="townhall-topic"
                  data-help-section="sources"
                  aria-label="Help: Sources"
                  aria-expanded="false"
                >?</button>
              </legend>
              <div id="statement-sources-list">
                <div class="statement-source-row">
                  <input
                    id="statement-source-1"
                    class="statement-source-input"
                    type="url"
                    inputmode="url"
                    placeholder="https://example.org/source"
                  />
                  <button class="button button--small button--secondary statement-source-remove" type="button" data-source-index="0">
                    Remove
                  </button>
                </div>
                <div class="statement-source-row is-hidden">
                  <input
                    id="statement-source-2"
                    class="statement-source-input"
                    type="url"
                    inputmode="url"
                    placeholder="https://example.org/source"
                  />
                  <button class="button button--small button--secondary statement-source-remove" type="button" data-source-index="1">
                    Remove
                  </button>
                </div>
                <div class="statement-source-row is-hidden">
                  <input
                    id="statement-source-3"
                    class="statement-source-input"
                    type="url"
                    inputmode="url"
                    placeholder="https://example.org/source"
                  />
                  <button class="button button--small button--secondary statement-source-remove" type="button" data-source-index="2">
                    Remove
                  </button>
                </div>
              </div>
              <button class="link-button" id="add-source-link" type="button">Add another source</button>
            </fieldset>
            <p class="form-error is-hidden" id="compose-error" role="alert"></p>
            <p class="helper-text is-hidden" id="compose-success"></p>
            <button class="button button--small" type="submit" id="compose-submit">Post statement</button>
          </form>
        </section>

        <section class="card" id="sign-in-card">
          <h2>Join the discussion</h2>
          <p class="helper-text">
            Sign in to post statements, reply, react, and report.
            <button class="link-button" type="button" data-auth-open>Sign in</button>
          </p>
        </section>

        <section>
          <div class="form-label-row">
            <h2 class="section-heading-inline">Published Statements</h2>
            <button
              class="section-help-trigger"
              type="button"
              data-help-page="townhall-topic"
              data-help-section="responses"
              aria-label="Help: Responses"
              aria-expanded="false"
            >?</button>
          </div>
          <p class="helper-text">New statements appear here after review. Published statements are ordered newest first.</p>
          <div class="townhall-tag-browser" aria-labelledby="townhall-tag-browser-title">
            <div class="form-label-row">
              <h3 class="section-heading-inline section-heading-inline--small" id="townhall-tag-browser-title">Browse by tag</h3>
              <button
                class="section-help-trigger"
                type="button"
                data-help-page="townhall-topic"
                data-help-section="tag-browse"
                aria-label="Help: Browse by tag"
                aria-expanded="false"
              >?</button>
            </div>
            <div class="townhall-tag-filter" id="tag-filter-list" role="group" aria-label="Statement tags"></div>
          </div>
          <div id="statements-feed" class="townhall-feed"></div>
          <p class="helper-text is-hidden" id="feed-empty">No published statements yet.</p>
          <p class="form-error is-hidden" id="feed-error" role="alert"></p>
          <button class="button button--small button--secondary is-hidden" id="load-more" type="button">
            Load more
          </button>
        </section>
      </div>
    </section>
  </main>

  <Fragment slot="scripts">
    <script is:inline src="/js/section-help.js"></script>
    <script is:inline src="/townhall/townhall-topic.js"></script>
  </Fragment>
</BaseLayout>
