---
// src/pages/auth/login/index.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout title="Sign In | Grassroots Movement">
  <main class="max-w-lg mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold text-wy-charcoal mb-2">Sign in</h1>
    <p class="helper-text text-wy-dust mb-6">Access your account to continue.</p>

    <section id="auth-logged-in" class="survey-form is-hidden" aria-live="polite">
      <p>You are signed in.</p>
      <button class="button button--primary" type="button" id="logout-button">Sign out</button>
      <a class="button button--small" href="/surveys/list/">Back to surveys</a>
      <a class="button button--small" href="/account/">Manage passkeys</a>
    </section>

    <form id="auth-form" class="survey-form" data-auth-mode="login">
      <div class="passkey-actions">
        <button class="button button--primary" type="button" id="passkey-login-button">
          Sign in with passkey
        </button>
        <p class="helper-text">Use a passkey for faster sign-in, or use your password below.</p>
      </div>
      <div class="form-row">
        <label for="auth-email">Email</label>
        <input id="auth-email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="form-row">
        <label for="auth-password">Password</label>
        <input id="auth-password" name="password" type="password" autocomplete="current-password" required />
      </div>
      <p class="helper-text is-hidden" id="turnstile-login-label">Complete the human check to continue.</p>
      <div class="form-row is-hidden" id="turnstile-login"></div>
      <input type="hidden" id="turnstile-token" name="turnstileToken" />
      <p class="form-error is-hidden" id="auth-error" role="alert"></p>
      <p class="helper-text is-hidden" id="turnstile-login-status" role="status"></p>
      <button class="button button--primary" type="submit" id="auth-submit" disabled>Sign in</button>
    </form>

    <section class="survey-form is-hidden" id="login-passkey-nudge" aria-live="polite">
      <h2>Add a passkey for faster sign-in</h2>
      <p class="helper-text">Use this device or your phone. No password needed next time.</p>
      <div class="form-row">
        <button class="button button--primary" type="button" id="login-passkey-add">Add passkey</button>
        <button class="button button--small" type="button" id="login-passkey-skip">Not now</button>
      </div>
    </section>

    <p class="helper-text mt-4">
      Need an account? <a href="/auth/signup/" class="text-wy-ember hover:underline">Create one</a>
    </p>

    <section id="passkey-diagnostics" class="survey-form is-hidden" aria-live="polite">
      <h3>Passkey Diagnostics</h3>
      <pre id="passkey-diag-output" style="background:#f5f5f5;padding:1em;overflow:auto;max-height:300px;font-size:0.85em;"></pre>
      <button class="button button--small" type="button" id="passkey-diag-run">Run Diagnostics</button>
    </section>
  </main>

  <Fragment slot="scripts">
    <script is:inline src="/js/turnstile-loader.js"></script>
    <script is:inline src="/js/auth/turnstile-client.js"></script>
    <script is:inline src="/js/passkey-debug.js"></script>
    <script is:inline src="/js/auth.js"></script>
  </Fragment>
</BaseLayout>
