---
// src/pages/donate/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Donate | Grassroots Movement">
  <main>
    <h1>Support Our Mission</h1>
    <div class="donate-container">
      <h2>Help Us Continue This Work</h2>
      <p>Grassroots Movement relies on support from people like you to keep this platform running and accessible to all. Your donation helps us:</p>
      <ul>
        <li>Maintain and improve survey tools for communities</li>
        <li>Keep the platform free and open to all</li>
        <li>Support civic engagement and participation</li>
        <li>Develop new features and resources</li>
      </ul>

      <div class="donate-cta">
        <h3>Make a Donation</h3>
        <p>Please visit our campaign site to support this work:</p>
        <a href="https://skovgard2026.org/donate" class="button button--primary" target="_blank" rel="noopener noreferrer">
          Donate at Skovgard 2026 &rarr;
        </a>
      </div>

      <div class="donate-info">
        <p><strong>All donations support independent civic engagement and grassroots organizing.</strong></p>
        <p>Questions? <a href="mailto:support@grassrootsmvt.org">Contact us</a></p>
      </div>
    </div>
  </main>
</BaseLayout>
