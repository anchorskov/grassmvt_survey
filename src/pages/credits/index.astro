---
// src/pages/credits/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Credits | Grassroots Movement">
  <main>
    <h1>Credits</h1>
    <p>We thank the teams, maintainers, and contributors whose work powers this project.</p>

    <section>
      <h2>Development Tools</h2>
      <ul>
        <li><strong><a href="https://code.visualstudio.com/" rel="external">Microsoft Visual Studio Code</a></strong> - A powerful and lightweight source code editor</li>
        <li><strong><a href="https://github.com/features/copilot" rel="external">GitHub Copilot</a></strong> - AI-powered code completion and suggestions</li>
        <li><strong><a href="https://openai.com/codex" rel="external">Codex by OpenAI</a></strong> - Advanced language model powering AI assistance features</li>
      </ul>
    </section>

    <section>
      <h2>Survey &amp; Forms</h2>
      <ul>
        <li><strong><a href="https://surveyjs.io/" rel="external">SurveyJS</a></strong> - Open-source JavaScript library for building dynamic surveys and forms.</li>
      </ul>
    </section>

    <section>
      <h2>Authentication &amp; Sessions</h2>
      <ul>
        <li><strong><a href="https://lucia-auth.com/" rel="external">Lucia</a></strong> - Session-based authentication library for web applications.</li>
      </ul>
    </section>
  </main>
</BaseLayout>
