{
  "title": "Digital Privacy, AI Surveillance & Digital Identity",
  "description": "Understand how people think about data privacy, AI-assisted monitoring, and digital identity systems.",
  "x_meta": {
    "flow": "sectioned",
    "sectionExitEnabled": true,
    "sectionExitLabel": "End of section",
