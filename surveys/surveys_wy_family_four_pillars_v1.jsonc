{
  "title": "Wyoming Four Pillars Survey",
  "description": "Measure where Wyoming voters stand on four core policy areas — life, religious liberty, family values, and education freedom — including which questions may require a constitutional amendment to resolve.",
  "completedHtml": "<p>Thank you. Your response has been recorded.</p>",
  "showQuestionNumbers": "on",
  "questionTitleLocation": "top",
  "questionErrorLocation": "bottom",
  "goNextPageAutomatic": false,
  "showProgressBar": "off",
  "completeText": "Submit survey",
  "x_meta": {
    "flow": "sectioned",
    "sectionExitEnabled": true,
    "sectionExitLabel": "End of section",
    "exitUrl": "/surveys/list/",
    "path": "divisive",
    "category_slug": "four-pillars",
