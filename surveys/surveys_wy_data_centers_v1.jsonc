{
  "title": "Wyoming Data Centers Survey",
  "description": "Measure what Wyoming voters believe about standards for large data center development, including water use, electric infrastructure, public input, disclosure, and who should set the rules.",
  "completedHtml": "<p>Thank you. Your response has been recorded.</p>",
  "showQuestionNumbers": "on",
  "questionTitleLocation": "top",
  "questionErrorLocation": "bottom",
  "goNextPageAutomatic": false,
  "showProgressBar": "off",
  "completeText": "Submit survey",
  "x_meta": {
    "flow": "sectioned",
    "sectionExitEnabled": true,
    "sectionExitLabel": "End of section",
    "exitUrl": "/surveys/list/",
