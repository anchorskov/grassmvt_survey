          "maxSelectedChoices": 3,
          "choices": [
            "Water use",
            "Water quality",
            "Electric rates for homes and small businesses",
            "Grid reliability",
            "Noise",
            "Wildlife and open space",
            "Housing or local service pressure",
            "Limited public input",
            "Long-term site cleanup or reuse",
            "I do not have major concerns",
            "Not sure"
