            "Very high",
            "Unsustainable",
            "Not sure"
          ]
        },
        {
          "type": "radiogroup",
          "name": "could_move_to_improve",
          "title": "10. If you wanted to move to improve your situation, could you?",
          "isRequired": true,
          "choices": [
            "Yes, easily",
            "Possibly",
            "Difficult",
            "Not realistic",
            "Not sure"
          ]
        }
      ]
    },
    {
      "name": "future_outlook",
      "title": "Section 6: Stability and future",
      "description": "How secure does the future feel from here?",
      "elements": [
        {
          "type": "radiogroup",
          "name": "future_confidence",
          "title": "11. How confident are you about your financial future?",
          "isRequired": true,
          "choices": [
            "Very confident",
            "Somewhat confident",
            "Uncertain",
            "Worried",
            "Very worried",
            "Not sure"
          ]
        },
        {
          "type": "radiogroup",
          "name": "main_future_concern",
          "title": "12. What concerns you most looking ahead?",
          "isRequired": true,
          "choices": [
            "Rising prices",
