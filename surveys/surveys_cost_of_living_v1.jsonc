            "Housing costs",
            "Health costs",
            "Debt",
            "Retirement security",
            "Supporting family",
            "Other",
            "Not sure"
          ],
          "showOtherItem": true,
          "otherText": "Other"
        }
      ]
    },
    {
      "name": "solutions",
      "title": "Section 7: What would help most",
      "description": "Which changes would relieve pressure the fastest?",
      "elements": [
        {
          "type": "checkbox",
          "name": "changes_that_help_most",
          "title": "13. Which changes would help you most right now? Pick up to 3.",
          "isRequired": true,
          "maxSelectedChoices": 3,
          "choices": [
            "Lower everyday costs such as food, fuel, or utilities",
            "Higher wages or income",
            "Lower housing costs",
            "Lower health care costs",
            "Lower taxes or fees",
            "More stable work opportunities",
