        },
        {
          "type": "radiogroup",
          "name": "q6_clarity_terms",
          "title": "6. How clear is the difference between market value, assessed value, taxable value, and the final tax bill?",
          "choices": [
            "Very clear",
            "Somewhat clear",
            "Neutral",
            "Somewhat unclear",
            "Very unclear",
            "Unsure"
          ]
        },
