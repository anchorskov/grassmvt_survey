{
  "title": "Education & Skills Access",
  "description": "Understand whether people can access affordable, useful education and training where they live.",
  "x_meta": {
    "flow": "sectioned",
    "sectionExitEnabled": true,
    "sectionExitLabel": "End of section",
    "exitUrl": "/surveys/list/",
