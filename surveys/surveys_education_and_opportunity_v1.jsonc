          "type": "radiogroup",
          "name": "could_improve_locally",
          "title": "11. Do you believe you could improve your situation through education or training without leaving your area?",
          "isRequired": true,
          "choices": [
            "Yes, definitely",
            "Possibly",
            "Unlikely",
            "No",
            "Not sure"
          ]
