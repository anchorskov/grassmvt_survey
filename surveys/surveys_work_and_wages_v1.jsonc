  "completeText": "Submit survey",
  "completedHtml": "<h3>Thank you.</h3><p>Your response has been recorded.</p>",
  "pages": [
    {
      "name": "employment_snapshot",
      "title": "Section 1: Current work",
      "description": "Your current employment situation.",
      "elements": [
        {
          "type": "radiogroup",
          "name": "employment_status",
          "title": "1. What best describes your current work situation?",
          "isRequired": true,
          "choices": [
            "Full-time employment",
            "Part-time employment",
            "Self-employed or business owner",
            "Multiple jobs",
            "Unemployed",
            "Retired",
            "Student",
            "Other",
            "Prefer not to answer"
          ],
          "showOtherItem": true
        },
        {
          "type": "radiogroup",
          "name": "job_stability",
          "title": "2. How stable is your current work situation?",
          "isRequired": true,
          "choices": [
            "Very stable",
            "Mostly stable",
            "Uncertain",
            "At risk",
            "Not stable",
            "Not sure"
          ]
        }
      ]
    },
    {
      "name": "income_reliability",
      "title": "Section 2: Income reliability",
      "description": "How predictable your income is.",
      "elements": [
        {
          "type": "radiogroup",
          "name": "income_predictability",
          "title": "3. How predictable is your income month to month?",
          "isRequired": true,
          "choices": [
            "Very predictable",
            "Mostly predictable",
            "Somewhat unpredictable",
            "Highly unpredictable",
            "Not sure"
          ]
        },
        {
          "type": "radiogroup",
          "name": "income_sufficiency",
          "title": "4. Does your income cover your basic needs?",
          "isRequired": true,
          "choices": [
            "Yes, comfortably",
            "Yes, but tight",
            "Barely",
            "No",
            "Not sure",
            "Prefer not to answer"
          ]
        }
      ]
    },
    {
      "name": "financial_buffer",
      "title": "Section 3: Financial buffer",
      "description": "Ability to handle disruption.",
      "elements": [
        {
          "type": "radiogroup",
          "name": "emergency_buffer",
          "title": "5. If your income stopped today, how long could you cover expenses?",
          "isRequired": true,
          "choices": [
            "More than 6 months",
            "3-6 months",
            "1-3 months",
            "Less than 1 month",
            "Not sure"
          ]
        },
        {
          "type": "radiogroup",
          "name": "recent_income_disruption",
          "title": "6. Have you experienced a disruption in income in the past year?",
          "isRequired": true,
          "choices": [
            "Yes, major disruption",
            "Yes, minor disruption",
            "No",
            "Not sure"
          ]
        }
      ]
    },
    {
      "name": "work_conditions",
      "title": "Section 4: Work conditions",
      "description": "Quality and sustainability of work.",
      "elements": [
        {
          "type": "radiogroup",
          "name": "hours_stability",
          "title": "7. How consistent are your working hours?",
          "isRequired": true,
          "choices": [
            "Very consistent",
            "Mostly consistent",
            "Somewhat inconsistent",
            "Highly inconsistent",
            "Not applicable"
          ]
        },
        {
          "type": "radiogroup",
          "name": "job_fit",
          "title": "8. How well does your work match your skills and goals?",
          "isRequired": true,
          "choices": [
            "Very well",
            "Somewhat well",
            "Not well",
            "Not at all",
            "Not sure"
          ]
        }
      ]
    },
    {
      "name": "mobility",
