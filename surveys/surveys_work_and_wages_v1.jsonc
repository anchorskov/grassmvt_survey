          "title": "9. Are better job opportunities available where you live?",
          "isRequired": true,
          "choices": [
            "Yes, many opportunities",
            "Some opportunities",
            "Very limited",
            "No realistic opportunities",
            "Not sure"
          ]
        },
        {
          "type": "radiogroup",
          "name": "ability_to_transition",
          "title": "10. If needed, could you transition to a better job?",
