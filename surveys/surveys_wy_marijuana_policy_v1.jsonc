            {
              "value": "allow_medical_with_clinician",
              "text": "B. Wyoming should allow medical marijuana when patients and licensed clinicians believe it may help."
            },
            {
              "value": "adult_possession_criminal_penalties",
              "text": "C. Adult marijuana possession should carry criminal penalties."
            },
            {
              "value": "adult_possession_civil_or_lower_enforcement",
              "text": "D. Adult marijuana possession should be handled through civil penalties or lower-level enforcement."
