      "elements": [
        {
          "type": "radiogroup",
          "name": "drug_free_workplace_policy",
          "title": "17. Should employers be allowed to maintain drug-free workplace policies if marijuana law changes?",
          "choices": [
            "Yes, for all workplaces",
            "Yes, for safety-sensitive jobs only",
            "Off-duty legal use should be protected",
            "Marijuana should remain illegal",
            "Unsure"
          ]
        },
        {
          "type": "radiogroup",
          "name": "youth_access_concern",
          "title": "18. How concerned are you about youth access if marijuana law changes?",
          "choices": [
            "Very concerned",
            "Somewhat concerned",
            "Slightly concerned",
            "Low concern",
            "Unsure"
          ]
        },
        {
          "type": "radiogroup",
          "name": "unregulated_products_concern",
          "title": "19. How concerned are you about unregulated marijuana products if marijuana remains illegal?",
          "choices": [
            "Very concerned",
            "Somewhat concerned",
            "Slightly concerned",
            "Low concern",
            "Unsure"
          ]
        }
