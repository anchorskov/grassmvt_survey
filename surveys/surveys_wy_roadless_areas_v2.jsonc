    },
    {
      "name": "overall_approach",
      "title": "Section 2: Overall approach",
      "elements": [
        {
          "type": "radiogroup",
          "name": "roadless_approach",
          "title": "Which approach should Wyoming support for inventoried roadless areas?",
          "isRequired": true,
          "choices": [
            "Keep current roadless-area protections mostly in place",
            "Keep protections, but allow narrow site-specific exceptions for wildfire, watershed, or restoration work",
            "Replace the national rule with local forest-plan and project-level review",
            "Remove roadless-area protections and allow broader road construction and timber work through normal review",
            "Not sure"
          ]
        }
      ]
    },
