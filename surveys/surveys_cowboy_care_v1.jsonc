    {
      "name": "providers_and_malpractice",
      "title": "Section 4: Providers and malpractice",
      "description": "Provider protections, malpractice handling, and whether lower billing burden changes your view.",
      "elements": [
        {
          "type": "radiogroup",
          "name": "malpractice_approach_for_providers",
          "title": "If Wyoming creates Cowboy Care, what should happen with malpractice costs for approved providers?",
          "choices": [
            "Keep the current private malpractice system",
            "Create a state-backed malpractice pool",
            "Provide state malpractice coverage for participating providers",
            "Limit malpractice exposure under clear state standards",
            "Not sure"
          ]
        },
        {
          "type": "radiogroup",
          "name": "billing_complexity_support_effect",
          "title": "Would you be more likely to support Cowboy Care if it reduced billing complexity for doctors, clinics, and hospitals?",
          "choices": [
            "Much more likely",
            "Somewhat more likely",
            "No difference",
            "Somewhat less likely",
            "Much less likely",
            "Not sure"
          ]
