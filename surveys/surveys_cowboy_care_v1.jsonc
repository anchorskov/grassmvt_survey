{
  "title": "Cowboy Care Survey",
  "description": "This survey measures what Wyoming residents believe health care in Wyoming should look like, including cost, coverage, provider access, provider protections, and the possible role of a Wyoming-run system called Cowboy Care.",
  "completedHtml": "<p>Thank you. Your response has been recorded.</p>",
  "showQuestionNumbers": "on",
  "questionTitleLocation": "top",
  "questionErrorLocation": "bottom",
  "goNextPageAutomatic": false,
  "showProgressBar": "off",
  "x_meta": {
    "flow": "sectioned",
    "sectionExitEnabled": true,
    "sectionExitLabel": "End of section",
    "exitUrl": "/surveys/list/",
    "path": "divisive",
    "category_slug": "cowboy-care",
    "estimated_minutes": 6,
    "featured": true
  },
  "pages": [
    {
      "name": "intro",
      "elements": [
        {
          "type": "html",
          "name": "intro_overview",
          "html": "<h3>Purpose</h3><p>This survey measures what Wyoming residents believe health care in Wyoming should look like, including cost, coverage, provider access, provider protections, and the possible role of a Wyoming-run system called Cowboy Care. The goal is clarity, not persuasion.</p><h3>Definition used in this survey</h3><p><strong>Cowboy Care:</strong> For this survey, Cowboy Care means a Wyoming-run health coverage system where every Wyoming resident is covered, access is based on need rather than ability to pay, providers are paid through the system, and funding may come from wage-based contributions and other public or private payments.</p><h3>How responses will be used</h3><ul><li>Results will be published in aggregate.</li><li>Exact question wording and response options will be published with results.</li><li>A revision log will show what changed and why.</li><li>Individual responses remain private.</li></ul><h3>Instructions</h3><p>Please answer as honestly as you can. If you are unsure, choose Not sure where it is offered.</p>"
        }
      ]
    },
    {
      "name": "current_system",
      "title": "Section 1: The current system",
      "description": "Current cost pressure, current hardship, and which direction feels closest to your view.",
      "elements": [
        {
          "type": "radiogroup",
          "name": "current_health_care_costs",
          "title": "How would you describe health care costs for Wyoming families today?",
          "choices": [
            "Much too high",
            "Somewhat too high",
            "About right",
            "Somewhat low",
            "Much too low",
            "Not sure"
          ]
        },
        {
          "type": "radiogroup",
          "name": "current_system_hardship",
          "title": "Which part of the current system causes the most hardship?",
          "choices": [
            "Monthly premiums",
            "Deductibles",
            "Copays or coinsurance",
            "Prescription drug costs",
            "Surprise bills",
            "Travel or lack of nearby providers",
            "Difficulty understanding coverage",
            "Not sure"
          ],
          "showOtherItem": true,
          "otherText": "Other (write in)"
        },
        {
          "type": "radiogroup",
          "name": "closest_system_view",
          "title": "Which statement is closest to your view?",
          "choices": [
            "Wyoming should keep the current insurance system with smaller reforms",
            "Wyoming should create a public option alongside private insurance",
            "Wyoming should move to a universal Wyoming-run system like Cowboy Care",
            "Wyoming should use a hybrid system with basic universal coverage and optional private plans",
            "Not sure"
          ]
        }
      ]
    },
    {
      "name": "support_for_cowboy_care",
      "title": "Section 2: Support for Cowboy Care",
      "description": "Your overall support, which goals matter most, and the role private insurance should play.",
      "elements": [
        {
          "type": "radiogroup",
          "name": "cowboy_care_support",
          "title": "Based on the description above, do you support or oppose Cowboy Care?",
          "choices": [
            "Strongly support",
            "Somewhat support",
            "Neither support nor oppose",
            "Somewhat oppose",
            "Strongly oppose",
            "Not sure"
          ]
        },
        {
          "type": "checkbox",
          "name": "cowboy_care_priority_goals",
          "title": "If Wyoming created Cowboy Care, which goals matter most to you? Pick up to 3.",
          "choices": [
            "Every resident covered",
            "Lower family costs",
            "No one denied care because of income",
            "Protect rural hospitals and clinics",
            "Reduce paperwork and billing complexity",
            "Keep freedom to choose a doctor where available",
            "Strengthen mental health access",
            "Strengthen emergency and hospital care"
          ],
          "maxSelectedChoices": 3,
          "hasOther": true,
          "otherText": "Other (write in)"
        },
        {
          "type": "radiogroup",
          "name": "private_insurance_role",
          "title": "What role should private insurance have if Cowboy Care is adopted?",
          "choices": [
            "No role, the state system should replace it",
            "Private insurance should offer supplemental coverage only",
            "Private insurance should compete alongside Cowboy Care",
            "Private insurance should remain the primary system",
            "Not sure"
          ]
        }
      ]
    },
    {
      "name": "funding",
      "title": "Section 3: Funding",
      "description": "How a universal system should be paid for, if Wyoming creates one.",
      "elements": [
        {
          "type": "checkbox",
          "name": "preferred_funding_sources",
          "title": "How should Wyoming pay for a universal health coverage system, if it creates one? Pick up to 2.",
          "choices": [
