// title: Use of Military Force & AI in Warfare
{
  "title": "Use of Military Force & AI in Warfare",
  "description": "Understand how people think about military force, decision authority, accountability, and the role of AI in warfare.",
  "x_meta": {
    "flow": "sectioned",
    "sectionExitEnabled": true,
    "sectionExitLabel": "End of section",
